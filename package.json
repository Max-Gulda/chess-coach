{
  "name": "chess-coach",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local chess analysis with Stockfish, playable variations, and Chess.com board sync.",
  "scripts": {
    "postinstall": "npm run setup",
    "setup": "node scripts/prepare-assets.mjs && npm run extension",
    "start": "node scripts/start.mjs",
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "test:browser": "node scripts/check-ui.mjs",
    "test:extension": "node extension/check-sync.mjs",
    "extension": "node scripts/build-extension.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "chess.js": "^1.4.0",
    "stockfish": "19.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "esbuild": "^0.25.0",
    "prettier": "3.9.10",
    "vite": "^7.2.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Max-Gulda/chess-coach.git"
  },
  "bugs": {
    "url": "https://github.com/Max-Gulda/chess-coach/issues"
  },
  "homepage": "https://github.com/Max-Gulda/chess-coach#readme",
  "keywords": [
    "chess",
    "stockfish",
    "analysis",
    "webassembly",
    "browser-extension"
  ]
}
